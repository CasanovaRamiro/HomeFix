# Local dev image (hot reload). Production uses ./Dockerfile — do not confuse them.
FROM node:22-slim

RUN apt-get update -y && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm

WORKDIR /app

# Copy manifest + prisma schema first so `pnpm install` (postinstall: prisma generate) works,
# then install into the image. The source is bind-mounted at runtime; node_modules stays
# in an anonymous volume so the container's install isn't clobbered by the host's.
COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml ./
COPY prisma ./prisma
RUN pnpm install --no-frozen-lockfile

EXPOSE 3000
CMD ["pnpm", "dev"]
