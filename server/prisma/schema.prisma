// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  surname      String
  email        String   @unique
  password     String
  nationalId   String   @unique @map("national_id") // este seria el dni. aclaro por las dudas
  profilePicture        String?        @map("profile_picture") 
  role         String   @default("user")
  active       Boolean  @default(true)
  deleted      Boolean  @default(false)
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")
  posts     Post[]
  nationalIdTypeId String @map("national_id_type_id")
  addressId        String @map("address_id")
  nationalIdType   NationalIdType @relation(fields: [nationalIdTypeId], references: [id])
  address          Address        @relation(fields: [addressId], references: [id])

  @@map("user")
}

model Post {
  id          Int                @id @default(autoincrement())
  userId      Int
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  title       String
  description String
  address     String
  status      String             @default("Active")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  image       String
  categories  PostCategory[]
}

model Category {
  id    Int    @id @default(autoincrement())
  name  String @unique
  posts PostCategory[]
}

model PostCategory {
  id         Int      @id @default(autoincrement())
  postId     Int
  categoryId Int
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([postId, categoryId])

}




model NationalIdType { 
  id          String @id @default(uuid()) 
  description String
  users       User[]

  @@map("national_id_type") 
}




model Address {
  id        String   @id @default(uuid()) @map("address_id")
  street    String
  number    String
  city      String
  state     String
  users     User[]

  @@map("address")
}



                

