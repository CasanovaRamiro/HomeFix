// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model DniType {
  id          Int     @id @default(autoincrement())
  description String
  users       User[]

  @@map("dni_type")
}

model Address {
  id       Int     @id @default(autoincrement())
  street   String
  number   String
  city     String
  province String
  users    User[]

  @@map("address")
}

model ValidationLevel {
  id          Int              @id @default(autoincrement())
  description String
  users       UserValidation[]

  @@map("validation_level")
}

model Category {
  id           Int                   @id @default(autoincrement())
  description  String
  users        UserCategory[]
  publications PublicationCategory[]

  @@map("category")
}

model User {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  email     String   @unique
  password  String
  dni       String   @unique
  photo     String?
  role      String   @default("user")
  active    Boolean  @default(true)
  deleted   Boolean  @default(false)
  phone     String?
  createdAt DateTime @default(now())
  dniTypeId Int
  addressId Int

  dniType  DniType @relation(fields: [dniTypeId], references: [id])
  address  Address @relation(fields: [addressId], references: [id])

  publications           Publication[]
  requests               Request[]
  categories             UserCategory[]
  validations            UserValidation[]
  reviewsGiven           Review[]       @relation("ReviewerRelation")
  reviewsReceived        Review[]       @relation("WorkerRelation")
  conversationsInitiated Conversation[] @relation("InitiatorRelation")
  conversationsReceived  Conversation[] @relation("ReceiverRelation")

  @@map("user")
}

model UserValidation {
  id                Int             @id @default(autoincrement())
  userId            Int
  validationLevelId Int
  user              User            @relation(fields: [userId], references: [id])
  validationLevel   ValidationLevel @relation(fields: [validationLevelId], references: [id])

  @@map("user_validation")
}

model UserCategory {
  id         Int      @id @default(autoincrement())
  userId     Int
  categoryId Int
  user       User     @relation(fields: [userId], references: [id])
  category   Category @relation(fields: [categoryId], references: [id])

  @@map("user_category")
}

model Publication {
  id          Int      @id @default(autoincrement())
  description String
  date        DateTime
  photo       String?
  status      String
  startDate   DateTime
  endDate     DateTime
  type        String
  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  requests   Request[]
  categories PublicationCategory[]

  @@map("publication")
}

model PublicationCategory {
  id            Int         @id @default(autoincrement())
  categoryId    Int
  publicationId Int
  category      Category    @relation(fields: [categoryId], references: [id])
  publication   Publication @relation(fields: [publicationId], references: [id])

  @@map("publication_category")
}

model Request {
  id            Int         @id @default(autoincrement())
  workerUserId  Int
  publicationId Int
  status        String
  worker        User        @relation(fields: [workerUserId], references: [id])
  publication   Publication @relation(fields: [publicationId], references: [id])

  conversation Conversation?
  reviews      Review[]

  @@map("request")
}

model Conversation {
  id          Int     @id @default(autoincrement())
  requestId   Int     @unique
  initiatorId Int
  receiverId  Int
  description String? @db.Text

  request   Request @relation(fields: [requestId], references: [id])
  initiator User    @relation("InitiatorRelation", fields: [initiatorId], references: [id])
  receiver  User    @relation("ReceiverRelation", fields: [receiverId], references: [id])

  @@map("conversation")
}

model Review {
  id          Int     @id @default(autoincrement())
  requestId   Int
  reviewerId  Int
  workerId    Int
  description String? @db.Text
  rating      Float
  mediaUrls   String? @db.Text

  request  Request @relation(fields: [requestId], references: [id])
  reviewer User    @relation("ReviewerRelation", fields: [reviewerId], references: [id])
  worker   User    @relation("WorkerRelation", fields: [workerId], references: [id])

  @@map("review")
}
