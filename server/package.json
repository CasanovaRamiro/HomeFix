{
  "name": "server",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:test": "cross-env DATABASE_URL=mysql://ofix:ofix123@localhost:3306/ofix_test prisma db push --accept-data-loss --skip-generate",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "didit:create-workflow": "tsx scripts/createDiditWorkflow.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage:service": "vitest run --coverage test/service",
    "test:coverage:data": "vitest run --coverage test/data",
    "test:coverage:routes": "vitest run --coverage test/routes"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/generative-ai": "~0.24.1",
    "@prisma/client": "~5.22.0",
    "@types/socket.io": "~3.0.2",
    "cloudinary": "~2.10.0",
    "cors": "~2.8.6",
    "dotenv": "~17.4.2",
    "express": "~5.2.1",
    "express-oauth2-jwt-bearer": "~1.9.0",
    "morgan": "~1.10.1",
    "multer": "~2.1.1",
    "openapi-types": "^12.1.3",
    "socket.io": "~4.8.3",
    "swagger-ui-express": "^5.0.1",
    "telegraf": "~4.16.3"
  },
  "onlyBuiltDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "esbuild",
    "prisma",
    "unrs-resolver"
  ],
  "devDependencies": {
    "@eslint/js": "~9.39.4",
    "@types/cors": "~2.8.17",
    "@types/express": "~5.0.0",
    "@types/morgan": "~1.9.10",
    "@types/multer": "~2.1.0",
    "@types/node": "~22.0.0",
    "@types/supertest": "~6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "~4.1.4",
    "cross-env": "~10.1.0",
    "eslint": "~9.0.0",
    "nodemon": "~3.1.14",
    "prisma": "~5.22.0",
    "supertest": "~7.2.2",
    "tsx": "~4.19.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "~8.33.0",
    "vitest": "~4.1.4"
  }
}
