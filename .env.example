# Build-time Vite vars — passed to docker compose as build args.
# Copy this file to .env at the repo root before running: docker compose up --build
VITE_AUTH0_DOMAIN=https://your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_auth0_client_id
VITE_AUTH0_AUDIENCE=your_auth0_audience
VITE_AUTH0_CALLBACK_URL=http://localhost:3000/auth/callback
